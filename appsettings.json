{
  "ConnectionStrings": { "DefaultConnection": "Host=localhost;Port=5432;Database=foll_emergency;Username=foll;Password=" },
  "JwtSettings": { "Secret": "" },
  "InternalApi": { "ApiKey": "" },
  "Services": {
    "Care": { "BaseUrl": "http://localhost:5237", "TimeoutSeconds": 10 },
    "Devices": { "BaseUrl": "http://localhost:5237", "TimeoutSeconds": 10 },
    "Notifications": { "BaseUrl": "http://localhost:5237", "TimeoutSeconds": 20 }
  },
  "EmergencyAnalyticsMqtt": {
    "Enabled": true, "Host": "localhost", "Port": 1883,
    "ClientId": "foll-emergency-service-subscriber", "PublisherClientId": "foll-emergency-service-publisher",
    "FallDetectedTopic": "foll/devices/+/fall-detected", "FallCancelledTopic": "foll/devices/+/fall-cancelled",
    "IncidentClosedTopic": "foll/devices/{deviceId}/incident-closed", "UseTls": false
  },
  "Outbox": { "Enabled": true, "PollIntervalSeconds": 5, "BatchSize": 20 },
  "ApplyMigrationsOnStartup": false,
  "Swagger": { "Enabled": false },
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*"
}
